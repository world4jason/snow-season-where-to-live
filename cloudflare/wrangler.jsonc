{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snow-season-where-to-live-api",
  "main": "worker-enhanced.js",
  "compatibility_date": "2026-08-25",
  "triggers": {
    "crons": ["20 0 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "c683449c039a4ba9803e8117952ca72a"
    }
  ],
  "ratelimits": [
    {
      "name": "MANUAL_SEARCH_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
